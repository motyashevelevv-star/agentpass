# Use infra/bootstrap.py to generate a persistent encryption key.
DATABASE_URL=postgresql+psycopg://agentpass:local-sandbox-only@localhost:5432/agentpass
ENVIRONMENT=sandbox
ENCRYPTION_KEY=GENERATE_WITH_BOOTSTRAP
WEB_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
SEED_DEMO=true
DEMO_PASSWORD=AgentPass-demo-2026!
WEBHOOK_HOST_ALLOWLIST=
# Sandbox only. Pilot requires closed registration, MFA, HTTPS, separate runtime
# database role/verified TLS and a separately managed execution signing key.
ALLOW_PUBLIC_REGISTRATION=true
REQUIRE_MFA=false
EXECUTION_SIGNING_KEY=
EXECUTION_KEY_ID=local-v1
EXECUTION_GRANT_SECONDS=120
YOOKASSA_SANDBOX_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
PAYMENT_RETURN_URL=
