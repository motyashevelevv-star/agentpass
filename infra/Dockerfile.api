# syntax=docker/dockerfile:1
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/apps/api
WORKDIR /app
COPY apps/api/requirements.lock apps/api/requirements.lock
RUN --mount=type=secret,id=proxy_ca,required=false \
    if [ -f /run/secrets/proxy_ca ]; then PIP_CERT=/run/secrets/proxy_ca pip install --no-cache-dir -r apps/api/requirements.lock; else pip install --no-cache-dir -r apps/api/requirements.lock; fi
COPY --chown=10001:10001 apps/api apps/api
RUN useradd --create-home --uid 10001 agentpass
USER agentpass
EXPOSE 8000
CMD ["uvicorn", "agentpass.main:app", "--host", "0.0.0.0", "--port", "8000"]
